# Web项目环境变量配置示例
# 复制此文件为 .env 并根据实际部署环境修改

# 项目路径配置
FINANCE_AGENT_DIR=/path/to/finance-claude-code-agent
FINANCE_REPORTS_DIR=/path/to/finance-claude-code-agent-reports

# 服务器端口配置
SERVER_PORT=3001
CLIENT_PORT=3000

# CORS配置
CORS_ORIGIN=http://localhost:3000

# 可选：生产环境配置
# NODE_ENV=production
# REACT_APP_API_URL=http://your-server.com:3001